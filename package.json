{
  "name": "scriptless",
  "version": "1.0.0",
  "description": "A privacy-first reader: paste a link, get only the text.",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "build:site": "node scripts/build-site.js"
  },
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "sanitize-html": "^2.18.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
